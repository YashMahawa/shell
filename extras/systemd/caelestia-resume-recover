#!/usr/bin/env bash
set -u

USER_NAME="${CAELESTIA_USER:-yash}"
USER_ID="${CAELESTIA_UID:-1000}"
RUNTIME_DIR="/run/user/${USER_ID}"
BUS="unix:path=${RUNTIME_DIR}/bus"
LOG="/var/log/caelestia-resume-recover.log"
IPC="${CAELESTIA_IPC:-/home/yash/.local/bin/caelestia-qs-ipc}"

log() {
    printf '%s %s\n' "$(date --iso-8601=seconds)" "$*" >> "$LOG" 2>/dev/null || true
}

run_user() {
    /usr/bin/runuser -u "$USER_NAME" -- env \
        XDG_RUNTIME_DIR="$RUNTIME_DIR" \
        DBUS_SESSION_BUS_ADDRESS="$BUS" \
        "$@"
}

qs_ipc() {
    run_user /usr/bin/timeout 3 "$IPC" "$@"
}

log "resume recovery: restarting Caelestia Quickshell"
run_user /usr/bin/systemctl --user restart caelestia-quickshell.service >> "$LOG" 2>&1 || {
    log "resume recovery: restart failed"
    exit 0
}

for _ in $(seq 1 30); do
    if qs_ipc lock isLocked >> "$LOG" 2>&1; then
        log "resume recovery: IPC ready, requesting lock"
        qs_ipc lock safeLock >> "$LOG" 2>&1 || log "resume recovery: lock request failed"
        exit 0
    fi
    /usr/bin/sleep 0.5
done

log "resume recovery: IPC did not become ready"
