#!/bin/bash
# Automate the installation and service enablement of the greeter.
# This script configures the greeter as the system's default display manager.

if [ "$EUID" -ne 0 ]; then
  echo "Please run as root"
  exit 1
fi

ACTION=$1

if [ "$ACTION" = "rollback" ] || [ "$ACTION" = "uninstall" ]; then
  echo "Rolling back greeter configuration..."
  if [ -f /etc/greetd/config.toml.bak ]; then
    mv /etc/greetd/config.toml.bak /etc/greetd/config.toml
    echo "Restored original /etc/greetd/config.toml"
  else
    echo "No backup found, removing generated config..."
    rm -f /etc/greetd/config.toml
  fi
  
  systemctl disable greetd.service

  if [ -f /etc/greetd/prev_dm.bak ]; then
    PREV_DM=$(cat /etc/greetd/prev_dm.bak)
    if [ -n "$PREV_DM" ]; then
      if ! systemctl list-unit-files "$PREV_DM" >/dev/null 2>&1; then
        echo "FATAL: Previous display manager $PREV_DM does not exist!"
        exit 1
      fi
      if ! systemctl enable "$PREV_DM"; then
        echo "FATAL: Failed to enable $PREV_DM!"
        exit 1
      fi
      echo "Restored previous display manager: $PREV_DM"
    fi
    rm -f /etc/greetd/prev_dm.bak
  fi

  if [ -f /etc/greetd/prev_default_target.bak ]; then
    PREV_TARGET=$(cat /etc/greetd/prev_default_target.bak)
    if [ -n "$PREV_TARGET" ]; then
      if ! systemctl set-default "$PREV_TARGET"; then
        echo "FATAL: Failed to set default target $PREV_TARGET!"
        exit 1
      fi
      echo "Restored previous default target: $PREV_TARGET"
    fi
    rm -f /etc/greetd/prev_default_target.bak
  fi

  echo "Rollback complete."
  exit 0
fi

if [ "$ACTION" != "--apply" ]; then
  echo "Dry-run / Status Output:"
  echo "Current Default Target: $(systemctl get-default 2>/dev/null)"
  
  CURRENT_DM=""
  if [ -L /etc/systemd/system/display-manager.service ]; then
    CURRENT_DM=$(basename "$(readlink /etc/systemd/system/display-manager.service)")
  else
    for dm in gdm lightdm sddm lxdm xdm; do
      if systemctl is-enabled "$dm.service" >/dev/null 2>&1; then
        CURRENT_DM="$dm.service"
        break
      fi
    done
  fi
  echo "Current Display Manager: ${CURRENT_DM:-None}"
  echo "greetd installed user: $(getent passwd greeter >/dev/null && echo "Yes" || echo "No")"
  echo ""
  echo "To install and enable the greeter as your default display manager, run:"
  echo "  $0 --apply"
  exit 0
fi

echo "Installing greeter configuration..."

# Create/validate greeter user
if ! getent passwd greeter >/dev/null; then
  echo "Creating greeter user..."
  useradd -M -r -s /sbin/nologin greeter || echo "Failed to create greeter user, it may already exist."
fi

mkdir -p /etc/greetd
if [ -f /etc/greetd/config.toml ] && [ ! -f /etc/greetd/config.toml.bak ]; then
  cp /etc/greetd/config.toml /etc/greetd/config.toml.bak
  echo "Backed up existing config to /etc/greetd/config.toml.bak"
fi

# Preserve previous default target
systemctl get-default > /etc/greetd/prev_default_target.bak 2>/dev/null || true

# Preserve previous display manager
PREV_DM=""
if [ -L /etc/systemd/system/display-manager.service ]; then
  PREV_DM=$(basename "$(readlink /etc/systemd/system/display-manager.service)")
else
  for dm in gdm lightdm sddm lxdm xdm; do
    if systemctl is-enabled "$dm.service" >/dev/null 2>&1; then
      PREV_DM="$dm.service"
      break
    fi
  done
fi

if [ -n "$PREV_DM" ] && [ "$PREV_DM" != "greetd.service" ]; then
  echo "$PREV_DM" > /etc/greetd/prev_dm.bak
  systemctl disable "$PREV_DM" || true
else
  > /etc/greetd/prev_dm.bak
fi

cat <<CONF > /etc/greetd/config.toml
[terminal]
vt = 1

[default_session]
command = "caelestia-shell -c /usr/share/quickshell/caelestia/greeter.qml"
user = "greeter"
CONF

systemctl enable greetd.service
systemctl set-default graphical.target
echo "Greeter configured successfully. Use '$0 rollback' to revert."
