#!/bin/bash
# Automate the installation and service enablement of the greeter.
# This script configures the greeter as the system's default display manager.

if [ "$EUID" -ne 0 ]; then
  echo "Please run as root"
  exit 1
fi

ACTION=""
OPT_IN=0

for arg in "$@"; do
  case "$arg" in
    --apply|rollback|uninstall)
      if [ -z "$ACTION" ]; then
        ACTION="$arg"
      fi
      ;;
    --force|-f|--overwrite|--overwrite-config|--enable-dm|--opt-in)
      OPT_IN=1
      ;;
  esac
done

if [ -z "$ACTION" ]; then
  ACTION="$1"
fi

detect_active_dm() {
  if [ -L /etc/systemd/system/display-manager.service ]; then
    basename "$(readlink /etc/systemd/system/display-manager.service)"
  else
    for dm in sddm gdm lightdm lxdm xdm greetd; do
      if systemctl is-enabled "$dm.service" >/dev/null 2>&1; then
        echo "$dm.service"
        return
      fi
    done
  fi
}

if [ "$ACTION" = "rollback" ] || [ "$ACTION" = "uninstall" ]; then
  echo "Rolling back greeter configuration..."
  if [ -f /etc/greetd/config.toml.bak ]; then
    mv /etc/greetd/config.toml.bak /etc/greetd/config.toml
    echo "Restored original /etc/greetd/config.toml"
  else
    echo "No backup found, removing generated config..."
    rm -f /etc/greetd/config.toml
  fi
  
  systemctl disable greetd.service

  if [ -f /etc/greetd/prev_dm.bak ]; then
    PREV_DM=$(cat /etc/greetd/prev_dm.bak)
    if [ -n "$PREV_DM" ]; then
      if ! systemctl list-unit-files "$PREV_DM" >/dev/null 2>&1; then
        echo "FATAL: Previous display manager $PREV_DM does not exist!"
        exit 1
      fi
      if ! systemctl enable "$PREV_DM"; then
        echo "FATAL: Failed to enable $PREV_DM!"
        exit 1
      fi
      echo "Restored previous display manager: $PREV_DM"
    fi
    rm -f /etc/greetd/prev_dm.bak
  fi

  if [ -f /etc/greetd/prev_default_target.bak ]; then
    PREV_TARGET=$(cat /etc/greetd/prev_default_target.bak)
    if [ -n "$PREV_TARGET" ]; then
      if ! systemctl set-default "$PREV_TARGET"; then
        echo "FATAL: Failed to set default target $PREV_TARGET!"
        exit 1
      fi
      echo "Restored previous default target: $PREV_TARGET"
    fi
    rm -f /etc/greetd/prev_default_target.bak
  fi

  echo "Rollback complete."
  exit 0
fi

if [ "$ACTION" != "--apply" ]; then
  echo "Dry-run / Status Output:"
  echo "Current Default Target: $(systemctl get-default 2>/dev/null)"
  CURRENT_DM=$(detect_active_dm)
  echo "Current Display Manager: ${CURRENT_DM:-None}"
  echo "greetd installed user: $(getent passwd greeter >/dev/null && echo "Yes" || echo "No")"
  if getent passwd greeter >/dev/null; then
    GREETER_GROUPS=$(id -Gn greeter 2>/dev/null | tr ' ' ',')
    echo "Greeter account group memberships: ${GREETER_GROUPS:-none}"
  fi
  echo ""
  echo "To install and enable the greeter as your default display manager, run:"
  echo "  $0 --apply [--force]"
  exit 0
fi

export PATH=$PATH:/usr/sbin:/sbin:/usr/bin:/bin

# Perform all preflight checks and explicit opt-in decisions before any mutation.
CURRENT_DM=$(detect_active_dm)
echo "Detected active display manager: ${CURRENT_DM:-None}"

CONFIG_EXISTS=0
if [ -f /etc/greetd/config.toml ]; then
  CONFIG_EXISTS=1
fi

DM_ACTIVE=0
if [ -n "$CURRENT_DM" ] && [ "$CURRENT_DM" != "greetd.service" ]; then
  DM_ACTIVE=1
fi

if [ "$OPT_IN" -ne 1 ]; then
  IF_TOUCHED=0
  if [ "$CONFIG_EXISTS" -eq 1 ]; then
    echo "Existing greetd configuration (/etc/greetd/config.toml) detected."
    echo "Leaving existing greetd configuration untouched (pass --force, --overwrite, or --enable-dm to explicitly opt in)."
    IF_TOUCHED=1
  fi
  if [ "$DM_ACTIVE" -eq 1 ]; then
    echo "Active display manager ($CURRENT_DM) detected."
    echo "Leaving existing $CURRENT_DM configuration untouched (pass --force, --overwrite, or --enable-dm to explicitly opt in)."
    IF_TOUCHED=1
  fi
  if [ "$IF_TOUCHED" -eq 1 ]; then
    echo "Installation finished without modifying existing display manager or greetd configuration."
    exit 0
  fi
fi

echo "Installing greeter configuration..."

# Stage and validate greetd files before modifying system services
mkdir -p /etc/greetd
STAGING_CONFIG="/etc/greetd/config.toml.tmp"

cat <<CONF > "$STAGING_CONFIG"
[terminal]
vt = 1

[default_session]
command = "caelestia-shell -c /usr/share/quickshell/caelestia/greeter.qml"
user = "greeter"
CONF

if [ ! -s "$STAGING_CONFIG" ]; then
  echo "FATAL: Staged greetd configuration is empty or was not created!"
  rm -f "$STAGING_CONFIG"
  exit 1
fi

if command -v greetd >/dev/null 2>&1; then
  if greetd --check --config "$STAGING_CONFIG" >/dev/null 2>&1; then
    echo "Validated staged greetd configuration."
  fi
fi

if [ -f /etc/greetd/config.toml ] && [ ! -f /etc/greetd/config.toml.bak ]; then
  cp /etc/greetd/config.toml /etc/greetd/config.toml.bak
  echo "Backed up existing config to /etc/greetd/config.toml.bak"
fi

mv "$STAGING_CONFIG" /etc/greetd/config.toml
echo "Staged greetd configuration written to /etc/greetd/config.toml"

# Create/validate greeter user without adding supplementary hardware groups.
# Device access on seat0 is provided via standard logind / udev seat ACLs.
if ! getent passwd greeter >/dev/null; then
  echo "Creating greeter user..."
  if ! useradd -M -r -s /sbin/nologin greeter; then
    echo "FATAL: Failed to create greeter user!"
    exit 1
  fi
else
  echo "Greeter user already exists."
fi

GREETER_GROUPS=$(id -Gn greeter 2>/dev/null | tr ' ' ',')
echo "Greeter account group memberships: ${GREETER_GROUPS:-none}"

# Preserve previous target & display manager state before disabling current DM
systemctl get-default > /etc/greetd/prev_default_target.bak 2>/dev/null || true

if [ -n "$CURRENT_DM" ] && [ "$CURRENT_DM" != "greetd.service" ]; then
  echo "$CURRENT_DM" > /etc/greetd/prev_dm.bak
  echo "Disabling current display manager: $CURRENT_DM..."
  systemctl disable "$CURRENT_DM" || true
else
  > /etc/greetd/prev_dm.bak
fi

if ! systemctl enable greetd.service; then
  echo "FATAL: Failed to enable greetd.service!"
  exit 1
fi
if ! systemctl set-default graphical.target; then
  echo "FATAL: Failed to set default graphical.target!"
  exit 1
fi
echo "Greeter configured successfully. Use '$0 rollback' to revert."
